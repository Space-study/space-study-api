{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      "mail/templates/**/*",
      {
        "include": "i18n/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}